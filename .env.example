# Copy this file to ".env" (same folder) and fill in the values.
# NEVER commit .env - it is in .gitignore.

# --- OpenAI (server-side only; never put this in the frontend) -------------
OPENAI_API_KEY=
# Any model that supports function calling in the Responses API.
# Check https://developers.openai.com/api/docs/models for current names.
# gpt-6-luna is OpenAI's low-cost option at the time of writing.
OPENAI_MODEL=gpt-6-luna

# --- App ----------------------------------------------------------------------
# Relative SQLite paths are resolved from the backend/ folder.
DATABASE_URL=sqlite:///./ecommerce.db
FRONTEND_ORIGIN=http://localhost:5173
MAX_TOOL_ROUNDS=8
APP_ENV=development

# Signs login tokens and the user context sent to the MCP servers.
# Use a long random value (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))").
APP_SECRET_KEY=change-me-to-a-long-random-string

# Optional tuning (defaults shown)
# APPROVAL_TTL_MINUTES=15
# TOOL_TIMEOUT_SECONDS=20
# HISTORY_MESSAGE_LIMIT=12
# CHAT_RATE_LIMIT_PER_MINUTE=20
